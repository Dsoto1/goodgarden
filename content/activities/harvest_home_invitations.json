			"speaker": "miriam",
			"text": "Harvest Home is next week! This year, we want every one of our friends to come: from the farm, the lake, the city, the monastery, the sea and the mountain."
		},
		{
			"speaker": "miriam",
			"text": "Will you write the invitation? I'll copy it for everyone."
		}
	],
	"steps": [
		{
			"id": "letter",
			"primitive": "compose_letter",
			"speaker": "miriam",
			"prompt": "Write the invitation: choose a word for each coloured space.",
			"hint": "Show me",
			"lines": [
				"Dear friend,",
				"Please come to {event}.",
				"It is in the {place}.",
				"Walk the {way} to find us!"
			],
			"choices": {
