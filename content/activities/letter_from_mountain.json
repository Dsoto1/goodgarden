					],
					"work": [
						"the new lambs",
						"the trail stones",
						"the hut"
					],
					"event": [
						"the festival",
						"the Spring Festival"
					],
					"bring": [
						"a happy heart",
						"a mountain flower",
						"lots of stories"
					]
				}
			},
			"feedback": {
				"all_good": "A fine letter. Miss Miriam will read it with a smile!"
			}
		}
	],
	"outro": [
		{
			"speaker": "silas",
			"text": "Off it goes with the mule. Go well, friend. I'll see you at the festival: I wouldn't miss it!"
		},
