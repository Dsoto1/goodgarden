		{
			"speaker": "silas",
			"text": "You'll be going home soon, for the festival. Would you like to send a letter ahead, to tell Miss Miriam you're coming?"
		},
		{
			"speaker": "silas",
			"text": "The mule goes down to the valley this afternoon. She'll carry it."
		}
	],
	"steps": [
		{
			"id": "letter",
			"primitive": "compose_letter",
			"speaker": "silas",
			"prompt": "Write the letter: choose a word for each coloured space.",
			"hint": "Show me",
			"lines": [
				"Dear Miss Miriam,",
				"I climbed to {where}!",
				"I helped with the {animals}.",
				"I am coming home for {event}."
			],
			"choices": {
				"where": [
					{
						"word": "the top",
						"icon": "flag"
					},
					{
						"word": "the summit",
						"icon": "mountain"
					}
				],
				"animals": [
					{
						"word": "lambs",
						"icon": "sheep"
					},
					{
						"word": "sheep",
						"icon": "sheep"
					}
				],
				"event": [
					{
						"word": "the festival",
						"icon": "flag"
					},
					{
						"word": "the Spring Festival",
						"icon": "flower"
					}
				]
			},
			"signature": "your friend",
			"older": {
				"lines": [
					"Dear Miss Miriam,",
					"Greetings from the mountain!",
					"I climbed to {where}, and saw {saw}.",
					"I helped Mr. Silas with {work}.",
					"I am coming home for {event},",
					"and I will bring {bring}."
				],
				"choices": {
					"where": [
						"the top",
						"the summit"
					],
					"saw": [
						"the whole land",
						"the sea shining",
