		"hands": {
			"mood": "wonder",
			"text": "Did you know Jesus was a carpenter too, when he was young? I like to think of him working with wood, just like this."
		},
		"again": {
			"mood": "gentle",
			"text": "Hello again! Measure twice, cut once. That's what my father taught me."
		},
		"done": {
			"mood": "joy",
			"text": "Thank you for your help today. Good work, done carefully, is a gift to everyone.",
